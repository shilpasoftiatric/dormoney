# ─────────────────────────────────────────────────────────
# Dormoney Phase 1 — Environment Variables
# Copy this to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dormoney?retryWrites=true&w=majority

# JWT Secret for Session & Rohit Mobile App Token Validation
JWT_SECRET=dormoney-jwt-secret-key-phase1-production

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Optional Twilio for SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
